# DOT Magic MCP Server Environment Variables

# Wallet Private Key (hex format, with or without 0x prefix)
# Use this for production with a dedicated key
# WALLET_PRIVATE_KEY=0x1234567890abcdef...

# OR use a mnemonic phrase
# WALLET_MNEMONIC=word1 word2 word3 ... word12

# For testing, you can use this well-known test mnemonic (DO NOT USE IN PRODUCTION!)
# WALLET_MNEMONIC=bottom drive obey lake curtain smoke basket hold race lonely fit walk

# Optional: Custom config file path
# DOT_MAGIC_CONFIG=/path/to/config.yaml
